# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL="postgresql://agendaflow:agendaflow_dev@localhost:5432/agendaflow?schema=public"
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Lembretes automáticos (opcional). Sem isso, use o botão "Enviar lembrete" da agenda.
# Gere com: openssl rand -base64 32. O agendador chama GET /api/cron/lembretes com "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# WhatsApp Cloud API (Meta). O template precisa estar aprovado; veja o README.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE="lembrete_agendamento"
