# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL="postgresql://agendaflow:agendaflow_dev@localhost:5432/agendaflow?schema=public"
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Lembretes automáticos (opcional). Sem isso, use o botão "Enviar lembrete" da agenda.
# Gere com: openssl rand -base64 32. O agendador chama GET /api/cron/lembretes com "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# WhatsApp Cloud API (Meta). O template precisa estar aprovado; veja o README.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE="lembrete_agendamento"

# Assinaturas (Stripe). Comece SEMPRE em modo teste (chaves sk_test_...). Sem a chave, a cobrança fica desligada e tudo é gratuito.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# IDs dos preços (price_...) criados no Stripe para cada plano.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# IA (Anthropic). Chamadas só no servidor. AI_MODEL é opcional (padrão: claude-haiku-5-5).
ANTHROPIC_API_KEY=""
AI_MODEL=""
